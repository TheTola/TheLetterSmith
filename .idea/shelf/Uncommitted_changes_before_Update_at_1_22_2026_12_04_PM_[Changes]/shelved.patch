-// File: script.js
-
-// ────────────────────────────────────────────────────────────────────────
-// 1) List of slide images in order.
-//    Adjust filenames / paths as needed (these assume cover.png, letter.png, etc.)
-// ────────────────────────────────────────────────────────────────────────
-const slideImages = [
-  'cover.png',
-  'letter.png',
-  'wall.png',
-  'back.png'
-];
-
-// ────────────────────────────────────────────────────────────────────────
-// 2) Grab references to DOM elements
-// ────────────────────────────────────────────────────────────────────────
-const slideImgEl = document.getElementById('slide-image');
-const prevBtn = document.getElementById('prev');
-const nextBtn = document.getElementById('next');
-const downloadBtn = document.getElementById('download');
-const playPauseBtn = document.getElementById('play-pause');
-
-let current = 0;          // index of currently displayed slide
-let autoplay = false;     // whether autoplay is active
-let autoplayInterval;     // holds setInterval ID when playing
-
-// ────────────────────────────────────────────────────────────────────────
-// 3) Utility: Update the <img> src based on `current` index
-// ────────────────────────────────────────────────────────────────────────
-function showSlide() {
-  const src = slideImages[current];
-  slideImgEl.src = src;
-  slideImgEl.alt = `Slide ${current + 1}`;
-}
-
-// ────────────────────────────────────────────────────────────────────────
-// 4) Prev / Next button handlers
-// ────────────────────────────────────────────────────────────────────────
-prevBtn.addEventListener('click', () => {
-  current = (current - 1 + slideImages.length) % slideImages.length;
-  showSlide();
-});
-
-nextBtn.addEventListener('click', () => {
-  current = (current + 1) % slideImages.length;
-  showSlide();
-});
-
-// ────────────────────────────────────────────────────────────────────────
-// 5) Play/Pause toggling
-// ────────────────────────────────────────────────────────────────────────
-playPauseBtn.addEventListener('click', () => {
-  autoplay = !autoplay;
-  if (autoplay) {
-    playPauseBtn.textContent = '⏸'; // change icon to “Pause”
-    autoplayInterval = setInterval(() => {
-      current = (current + 1) % slideImages.length;
-      showSlide();
-    }, 3000); // advance every 3 seconds
-  } else {
-    playPauseBtn.textContent = '▶'; // change back to “Play”
-    clearInterval(autoplayInterval);
-  }
-});
-
-// ────────────────────────────────────────────────────────────────────────
-// 6) Download button logic (desktop + Android + iOS)
-// ────────────────────────────────────────────────────────────────────────
-downloadBtn.addEventListener('click', () => {
-  const src = slideImages[current];
-
-  // Detect iOS (iPhone/iPad) by userAgent sniffing
-  const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) && !window.MSStream;
-
-  if (isIOS) {
-    // iOS Safari doesn’t honor <a download> reliably → open in new tab
-    window.open(src, '_blank');
-    return;
-  }
-
-  // For desktop & Android: fetch + Blob + <a download>
-  fetch(src)
-    .then(resp => resp.blob())
-    .then(blob => {
-      const blobUrl = URL.createObjectURL(blob);
-      const link = document.createElement('a');
-      link.href = blobUrl;
-      // Extract filename from path (e.g. 'letter.png')
-      link.download = src.substring(src.lastIndexOf('/') + 1);
-      document.body.appendChild(link);
-      link.click();
-      document.body.removeChild(link);
-      URL.revokeObjectURL(blobUrl);
-    })
-    .catch(() => {
-      // If something goes wrong (CORS or network), fallback to new tab
-      window.open(src, '_blank');
-    });
-});
-
-// ────────────────────────────────────────────────────────────────────────
-// 7) Initialize first slide
-// ────────────────────────────────────────────────────────────────────────
-showSlide();
