-/* Each slide is a 3D “pane” that can be flipped */
-.slide {
-  display: none;
-  position: absolute;
-  top: 0; left: 0;
-  width: 100%;
-  height: 100%;
-  backface-visibility: hidden;
-  transform-style: preserve-3d;
-  transform-origin: left center;
-  z-index: 1;
-}
-.slide.active {
-  display: block;
-  transform: perspective(2000px) rotateY(0deg);
-}
-.slide img {
-  max-width: 100%;
-  max-height: 100%;
-  margin: auto;
-  position: absolute;
-  top: 0; bottom: 0; left: 0; right: 0;
-  object-fit: contain;
-}
-
-/* Text-wall overlay */
-.text-wall {
-  position: absolute;
-  top: 50%; left: 50%;
-  transform: translate(-50%, -50%);
-  width: 80%;
-  max-height: 80%;
-  overflow-y: auto;
-  background: rgba(0, 0, 0, 0.5);
-  padding: 1em;
-  color: #fff;
