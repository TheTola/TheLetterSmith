-TEMPLATE_JS = """
-const cards      = document.getElementById('card-overlay');
-const slides     = document.querySelectorAll('.slide');
-const prevBtn    = document.getElementById('prev');
-const nextBtn    = document.getElementById('next');
-const downloadBtn= document.getElementById('download');
-const progress   = document.getElementById('progress');
-const closeText  = document.getElementById('close-text');
-const openText   = document.getElementById('open-text');
-let current      = 0;
-const total      = slides.length;
-
-// Initially hide slides and set up card overlay
-slides.forEach(slide => slide.classList.remove('active'));
-cards.addEventListener('click', () => {
-  // Trigger burst animation
-  cards.classList.add('burst');
-
-  // After the burst finishes, show first slide
-  cards.addEventListener('animationend', function handler() {
-    cards.removeEventListener('animationend', handler);
-    cards.style.display = 'none';  // hide the overlay
-    showSlide(0);
-  });
-});
-
-// Show slide #0 only after user clicks the overlay
-function showSlide(i) {
-  const nextIdx = ((i % total) + total) % total;
-  const oldIdx = current;
-
-  if (oldIdx === nextIdx) {
-    // If first click, just reveal slide #0 without flip
-    slides[nextIdx].classList.add('active');
-    updateProgress();
-    return;
-  }
-
-  const oldSlide = slides[oldIdx];
-  const newSlide = slides[nextIdx];
-
-  // 1) Flip out the old slide
-  oldSlide.classList.add('flip-out');
-  oldSlide.addEventListener('animationend', function onOut() {
-    oldSlide.removeEventListener('animationend', onOut);
-    oldSlide.classList.remove('active', 'flip-out');
-
-    // 2) Flip in the new slide
-    newSlide.classList.add('active', 'flip-in');
-    newSlide.addEventListener('animationend', function onIn() {
-      newSlide.removeEventListener('animationend', onIn);
-      newSlide.classList.remove('flip-in');
-
-      // 3) Update current index and progress
-      current = nextIdx;
-      updateProgress();
-    });
-  });
-}
-
-// Update "Page X of Y" text
-function updateProgress() {
-  progress.textContent = `Page ${current + 1} of ${total}`;
-}
-
-// Prev/Next handlers
-prevBtn.addEventListener('click', () => showSlide(current - 1));
-nextBtn.addEventListener('click', () => showSlide(current + 1));
-
-// Keyboard navigation
-document.addEventListener('keydown', (e) => {
-  if (e.key === 'ArrowLeft')       showSlide(current - 1);
-  if (e.key === 'ArrowRight' ||
-      e.key === ' '       ||
-      e.key === 'Enter')          showSlide(current + 1);
-});
-
-// Download current slide image
-const slideImages = [
-  'gallery/cover.png',
-  'gallery/letter.png',
-  'gallery/wall.png',
-  'gallery/back.png'
-];
-downloadBtn.addEventListener('click', () => {
